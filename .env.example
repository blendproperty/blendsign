# App
APP_DOMAIN=sign.blendproperty.co.za
ACME_EMAIL=brettd@blendproperty.co.za
NODE_ENV=production
ADMIN_EMAIL=admin@blendproperty.co.za
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# Postgres
POSTGRES_USER=blendsign
POSTGRES_PASSWORD=changeme
POSTGRES_DB=blendsign
DATABASE_URL=postgresql://blendsign:changeme@postgres:5432/blendsign

# Redis
REDIS_URL=redis://redis:6379

# Object storage (MinIO / S3-compatible — use af-south-1 in production)
MINIO_ROOT_USER=blendsign
MINIO_ROOT_PASSWORD=changeme
S3_ENDPOINT=http://minio:9000
S3_BUCKET=blendsign-documents
S3_REGION=af-south-1

# Delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BlendSign <sign@blendproperty.co.za>
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
