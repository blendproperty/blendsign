generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Org {
  id               String            @id @default(cuid())
  name             String
  street           String?
  city             String?
  province         String?
  country          String            @default("South Africa")
  postalCode       String?
  email            String?
  timezone         String            @default("Africa/Johannesburg")
  customDomain     String?
  legalDisclosure  String?
  logoUrl          String?
  logoKey          String?
  primaryColour    String            @default("#191919")
  accentColour     String            @default("#229D6C")
  emailFromName    String?
  emailFromAddress String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  defaultUsers     User[]            @relation("DefaultOrg")
  memberships      OrgMembership[]
  envelopes        Envelope[]
  contacts         Contact[]
  apiKeys          ApiKey[]
  webhooks         WebhookEndpoint[]
  templates        Template[]
  signForms        SignForm[]
}

model User {
  id           String          @id @default(cuid())
  org          Org?            @relation("DefaultOrg", fields: [orgId], references: [id])
  orgId        String?
  email        String          @unique
  name         String
  passwordHash String?
  firstName    String?
  lastName     String?
  company      String?
  jobTitle     String?
  dateFormat   String          @default("dd MMM yyyy, HH:mm")
  timezone     String          @default("Africa/Johannesburg")
  role         String          @default("member") // owner | admin | member
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @default(now()) @updatedAt
  envelopes    Envelope[]
  memberships  OrgMembership[]
  templates    Template[]
}

model OrgMembership {
  id        String   @id @default(cuid())
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId     String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      String   @default("member")
  createdAt DateTime @default(now())

  @@unique([orgId, userId])
  @@index([userId])
}

model Contact {
  id          String   @id @default(cuid())
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId       String
  name        String
  email       String?
  phone       String?
  countryCode String   @default("+27")
  shared      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId, name])
}

model ApiKey {
  id         String    @id @default(cuid())
  org        Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId      String
  name       String
  prefix     String
  keyHash    String    @unique
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([orgId, revokedAt])
}

model WebhookEndpoint {
  id              String   @id @default(cuid())
  org             Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId           String
  url             String
  events          String[]
  enabled         Boolean  @default(true)
  secretPrefix    String
  secretEncrypted String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orgId, enabled])
}

model Template {
  id            String          @id @default(cuid())
  org           Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId         String
  createdBy     User            @relation(fields: [createdById], references: [id])
  createdById   String
  name          String
  description   String?
  apiIdentifier String?
  version       Int             @default(1)
  active        Boolean         @default(true)
  originalKey   String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  roles         TemplateRole[]
  fields        TemplateField[]
  signForms     SignForm[]

  @@unique([orgId, apiIdentifier])
  @@index([orgId, name])
  @@index([orgId, active])
}

model TemplateRole {
  id         String          @id @default(cuid())
  template   Template        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String
  name       String
  order      Int             @default(0)
  fields     TemplateField[]

  @@unique([templateId, name])
  @@index([templateId, order])
}

model TemplateField {
  id               String       @id @default(cuid())
  template         Template     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId       String
  role             TemplateRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId           String
  type             FieldType
  label            String?
  dataKey          String?
  defaultValue     String?
  editableBySigner Boolean      @default(true)
  page             Int
  x                Float
  y                Float
  width            Float
  height           Float
  required         Boolean      @default(true)

  @@index([templateId, page])
  @@index([templateId, dataKey])
  @@index([roleId])
}

model SignForm {
  id          String   @id @default(cuid())
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId       String
  template    Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId  String
  name        String
  slug        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId, active])
}

enum EnvelopeStatus {
  DRAFT
  SENT
  PARTIALLY_SIGNED
  COMPLETED
  DECLINED
  EXPIRED
  VOIDED
}

model Envelope {
  id          String         @id @default(cuid())
  org         Org            @relation(fields: [orgId], references: [id])
  orgId       String
  createdBy   User           @relation(fields: [createdById], references: [id])
  createdById String
  title       String
  status      EnvelopeStatus @default(DRAFT)
  originalKey String // object storage key for uploaded PDF
  signedKey   String? // object storage key for final sealed PDF
  sha256      String? // hash of final signed document
  expiresAt   DateTime?
  deletedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  signers     Signer[]
  fields      Field[]
  auditEvents AuditEvent[]
}

enum SignerStatus {
  PENDING
  VIEWED
  SIGNED
  DECLINED
}

model Signer {
  id             String       @id @default(cuid())
  envelope       Envelope     @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  envelopeId     String
  name           String
  email          String?
  phone          String? // for WhatsApp/SMS delivery
  order          Int          @default(0) // routing order; same order = parallel
  token          String       @unique // signing link token
  status         SignerStatus @default(PENDING)
  signedAt       DateTime?
  declinedReason String?

  fields      Field[]
  auditEvents AuditEvent[]
}

enum FieldType {
  SIGNATURE
  INITIALS
  DATE
  TEXT
  CHECKBOX
}

model Field {
  id               String    @id @default(cuid())
  envelope         Envelope  @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  envelopeId       String
  signer           Signer    @relation(fields: [signerId], references: [id], onDelete: Cascade)
  signerId         String
  type             FieldType
  label            String?
  dataKey          String?
  required         Boolean   @default(true)
  editableBySigner Boolean   @default(true)
  page             Int
  x                Float
  y                Float
  width            Float
  height           Float
  value            String? // captured signature (base64/svg), text, or date
}

model AuditEvent {
  id         String   @id @default(cuid())
  envelope   Envelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  envelopeId String
  signer     Signer?  @relation(fields: [signerId], references: [id], onDelete: Cascade)
  signerId   String?
  eventType  String // created | sent | viewed | signed | declined | completed | expired
  ip         String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())
}
